{
  "name": "cypress-annotate",
  "version": "1.0.0",
  "description": "Draw a box on exactly what failed. Every failed Cypress test gets an annotated screenshot, in CI, with no AI and no browser download.",
  "keywords": [
    "cypress",
    "cypress-plugin",
    "cypress-screenshot",
    "screenshot",
    "screenshot-annotation",
    "annotate",
    "annotation",
    "test-failure",
    "failed-test",
    "debugging",
    "e2e",
    "e2e-testing",
    "visual-testing",
    "test-reporting",
    "test-artifacts",
    "ci",
    "github-actions",
    "cypress-cloud",
    "bounding-box",
    "pixel-accurate"
  ],
  "license": "MIT",
  "author": "bidemiajala",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bidemiajala/cypress-annotate.git"
  },
  "bugs": {
    "url": "https://github.com/bidemiajala/cypress-annotate/issues"
  },
  "homepage": "https://github.com/bidemiajala/cypress-annotate#readme",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cypress/task": {
      "types": "./dist/cypress/task.d.ts",
      "import": "./dist/cypress/task.js",
      "require": "./dist/cypress/task.js",
      "default": "./dist/cypress/task.js"
    },
    "./cypress/commands": {
      "types": "./dist/cypress/commands.d.ts",
      "import": "./dist/cypress/commands.js",
      "require": "./dist/cypress/commands.js",
      "default": "./dist/cypress/commands.js"
    },
    "./cypress/failure-hook": {
      "types": "./dist/cypress/failure-hook.d.ts",
      "import": "./dist/cypress/failure-hook.js",
      "require": "./dist/cypress/failure-hook.js",
      "default": "./dist/cypress/failure-hook.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "cypress/task": [
        "./dist/cypress/task.d.ts"
      ],
      "cypress/commands": [
        "./dist/cypress/commands.d.ts"
      ],
      "cypress/failure-hook": [
        "./dist/cypress/failure-hook.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "skills",
    "DOCS",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test:failure-selector": "tsx scripts/test-failure-selector.ts",
    "test:svg-escaping": "tsx scripts/test-svg-escaping.ts",
    "test:cypress": "tsx scripts/run-cypress.ts run --e2e --spec 'cypress/e2e/annotate.cy.ts,cypress/e2e/theme.cy.ts'",
    "test:cypress-failures": "tsx scripts/test-cypress-failures.ts",
    "cypress:open": "tsx scripts/run-cypress.ts open",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "sharp": "^0.35.4"
  },
  "peerDependencies": {
    "cypress": ">=13"
  },
  "peerDependenciesMeta": {
    "cypress": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "cypress": "^15.19.0",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3"
  }
}
