{
  "name": "cypress-annotate",
  "version": "0.2.0",
  "description": "Annotate Cypress screenshots and failed-test runs with pixel-accurate boxes, pointing at exactly what broke.",
  "keywords": [
    "cypress",
    "cypress-plugin",
    "cypress-screenshot",
    "screenshot",
    "annotate",
    "annotation",
    "test-failure",
    "failed-test",
    "debugging",
    "e2e",
    "e2e-testing",
    "visual-testing",
    "test-reporting",
    "ci",
    "cypress-cloud",
    "bounding-box",
    "pixel-accurate",
    "playwright",
    "ai",
    "llm",
    "claude",
    "agent"
  ],
  "license": "MIT",
  "author": "bidemiajala",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bidemiajala/cypress-annotate.git"
  },
  "bugs": {
    "url": "https://github.com/bidemiajala/cypress-annotate/issues"
  },
  "homepage": "https://github.com/bidemiajala/cypress-annotate#readme",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./reasoner": {
      "types": "./dist/claude-reasoner.d.ts",
      "import": "./dist/claude-reasoner.js",
      "require": "./dist/claude-reasoner.js",
      "default": "./dist/claude-reasoner.js"
    },
    "./cypress/task": {
      "types": "./dist/cypress/task.d.ts",
      "import": "./dist/cypress/task.js",
      "require": "./dist/cypress/task.js",
      "default": "./dist/cypress/task.js"
    },
    "./cypress/commands": {
      "types": "./dist/cypress/commands.d.ts",
      "import": "./dist/cypress/commands.js",
      "require": "./dist/cypress/commands.js",
      "default": "./dist/cypress/commands.js"
    },
    "./cypress/failure-hook": {
      "types": "./dist/cypress/failure-hook.d.ts",
      "import": "./dist/cypress/failure-hook.js",
      "require": "./dist/cypress/failure-hook.js",
      "default": "./dist/cypress/failure-hook.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "reasoner": [
        "./dist/claude-reasoner.d.ts"
      ],
      "cypress/task": [
        "./dist/cypress/task.d.ts"
      ],
      "cypress/commands": [
        "./dist/cypress/commands.d.ts"
      ],
      "cypress/failure-hook": [
        "./dist/cypress/failure-hook.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src/browser",
    "skills",
    "DOCS",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-browser-assets.js",
    "prepare": "npm run build",
    "annotate": "tsx src/cli.ts",
    "verify": "tsx scripts/verify.ts",
    "verify:image": "tsx scripts/verify-image.ts",
    "annotate-shot": "tsx scripts/annotate-shot.ts",
    "test:reasoner": "tsx scripts/test-reasoner.ts",
    "test:failure-selector": "tsx scripts/test-failure-selector.ts",
    "test:svg-escaping": "tsx scripts/test-svg-escaping.ts",
    "test:cypress": "tsx scripts/run-cypress.ts run --e2e --spec cypress/e2e/annotate.cy.ts",
    "test:cypress-failures": "tsx scripts/test-cypress-failures.ts",
    "explain-failures": "tsx scripts/explain-failures.ts",
    "cypress:open": "tsx scripts/run-cypress.ts open",
    "find-bugs": "tsx scripts/find-bugs.ts",
    "demo": "tsx scripts/find-bugs.ts --url fixtures/buggy-checkout.html --replay fixtures/buggy-checkout.expected.json --out-dir out/bugs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "sharp": "^0.35.4"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "cypress": ">=13",
    "playwright": "^1.56.1"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "cypress": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@types/node": "^24.10.1",
    "cypress": "^15.19.0",
    "playwright": "^1.56.1",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3"
  }
}
