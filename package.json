{
  "name": "ai-annotation",
  "version": "0.1.0",
  "description": "Turn a CSS selector into an accurately annotated screenshot.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cypress/*": {
      "types": "./dist/cypress/*.d.ts",
      "import": "./dist/cypress/*.js"
    }
  },
  "files": [
    "dist",
    "src/browser",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-browser-assets.js",
    "prepare": "npm run build",
    "annotate": "tsx src/cli.ts",
    "verify": "tsx scripts/verify.ts",
    "verify:image": "tsx scripts/verify-image.ts",
    "annotate-shot": "tsx scripts/annotate-shot.ts",
    "test:reasoner": "tsx scripts/test-reasoner.ts",
    "test:failure-selector": "tsx scripts/test-failure-selector.ts",
    "test:cypress": "tsx scripts/run-cypress.ts run --e2e --spec cypress/e2e/annotate.cy.ts",
    "test:cypress-failures": "tsx scripts/test-cypress-failures.ts",
    "explain-failures": "tsx scripts/explain-failures.ts",
    "cypress:open": "tsx scripts/run-cypress.ts open",
    "find-bugs": "tsx scripts/find-bugs.ts",
    "demo": "tsx scripts/find-bugs.ts --url fixtures/buggy-checkout.html --replay fixtures/buggy-checkout.expected.json --out-dir out/bugs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "sharp": "^0.34.4"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "cypress": ">=13",
    "playwright": "^1.56.1"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": { "optional": true },
    "cypress": { "optional": true },
    "playwright": { "optional": true }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@types/node": "^24.10.1",
    "cypress": "^15.19.0",
    "playwright": "^1.56.1",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3"
  }
}
